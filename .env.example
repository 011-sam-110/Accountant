# ============================================================================
#  MTD app — environment configuration
#  Copy to `.env` for local dev. EVERYTHING here has a safe local fallback,
#  so the app runs with an EMPTY .env (sqlite + local file storage + stub OCR
#  + console email/SMS). Fill these in to move toward production.
# ============================================================================

# --- Core ---
ENV=development
SECRET_KEY=dev-insecure-change-me-please-0123456789
BASE_URL=http://127.0.0.1:8000

# --- Database (default: ./local.db sqlite) ---
# Prod (Neon, POOLED endpoint): postgresql+psycopg://user:pass@ep-xxx-pooler.eu.aws.neon.tech/db?sslmode=require
# DATABASE_URL=postgresql+psycopg://...

# --- Storage (default: local ./local_storage) ---
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=mtd-receipts
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# --- OCR (default: stub — returns plausible data so the flow works offline) ---
# OCR_PROVIDER=gemini   # gemini | openai | anthropic | stub
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Email (default: console — prints the message to the server log) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
EMAIL_FROM=MTD App <noreply@example.com>

# --- SMS (default: console) — high-stakes reminders only ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# --- Auth / dev convenience ---
# When true (dev only), the 6-digit OTP is shown on screen + logged so you can
# log in without a real email provider. NEVER true in production.
DEV_SHOW_OTP=true
SEED_DEMO_USERS=true
