{
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["app/**"] }
    }
  ],
  "routes": [
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 7 * * *" }
  ]
}
